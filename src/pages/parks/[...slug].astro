---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// 1. Enable prerender if you want them static, OR remove getStaticPaths() for true SSR route handling:
export const prerender = false; // Set to false since you are running an SSR Node server

// 2. Grab the slug directly from the request parameters at runtime
const { slug } = Astro.params;

const parks = await getCollection('parks');
const park = parks.find((p) => p.id === slug);

if (!park) {
    return Astro.redirect('/404');
}

const { Content } = await render(park);
---

<BlogPost {...park.data}>
    <Content />
</BlogPost>
