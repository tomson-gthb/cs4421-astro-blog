---
interface Props {
  location: string;
}

const { location } = Astro.props;

// Fix 1: Switch from build-time import.meta.env to dynamic runtime process.env
const apiKey = process.env.OPENWEATHER_API_KEY;

const coordinatesMap: Record<string, { lat: number; lon: number }> = {
  // Parks
  "Serengeti": { lat: -2.3333, lon: 34.8333 },
  "Kilimanjaro": { lat: -3.3500, lon: 37.3333 },
  "Ruaha": { lat: -7.5000, lon: 35.0000 },
  "Tarangire": { lat: -3.8333, lon: 36.0000 },
  "Mikumi": { lat: -7.3833, lon: 37.4333 },
  "Saadani": { lat: -6.0333, lon: 38.7833 },
  "Kitulo": { lat: -9.0000, lon: 33.9000 },
  
  // Islands
  "Mafia": { lat: -7.8500, lon: 39.8000 },
  "Pemba": { lat: -5.2500, lon: 39.7500 },
  "Unguja": { lat: -6.1659, lon: 39.2026 },
  "Zanzibar": { lat: -6.1659, lon: 39.2026 },
  
  // Cities & Regions
  "Arusha": { lat: -3.3869, lon: 36.6830 },
  "Daressalaam": { lat: -6.7924, lon: 39.2083 },
  "Dodoma": { lat: -6.1630, lon: 35.7516 },
  "Mbeya": { lat: -8.9000, lon: 33.4500 },
  "Tanga": { lat: -5.0689, lon: 39.1001 }
};

// Fix 2: Search for a keyword within the layout title string so "Welcome to Pemba" matches "Pemba"
const matchedKey = Object.keys(coordinatesMap).find(key => 
  location.toLowerCase().includes(key.toLowerCase())
);
const coords = matchedKey ? coordinatesMap[matchedKey] : coordinatesMap["Arusha"];

let weatherData = null;
let error = null;

if (!apiKey) {
  error = 'Weather API key configuration missing';
  console.warn("--- WEATHER WARNING --- OPENWEATHER_API_KEY is not defined in your environment runtime variables!");
} else {
  try {
    // Fix 3: Rebuilt path with correct api endpoints, fully structured template literals, and https scheme
    const response = await fetch(
      `https://api.openweathermap.org/data/2.5/weather?lat=${coords.lat}&lon=${coords.lon}&units=metric&appid=${apiKey}`
    );

    if (!response.ok) {
      const errorBody = await response.text();
      throw new Error(`API Error Status ${response.status}: ${errorBody}`);
    }

    weatherData = await response.json();
  } catch (e: unknown) {
    const errorMessage = e instanceof Error ? e.message : 'Unknown network failure';
    console.error("--- WEATHER FETCH FAILED ---", errorMessage);
    error = 'Weather currently unavailable';
  }
}
/*
try {
  // Fetch using exact latitude and longitude instead of a text query string
  const response = await fetch(
    `https://api.openweathermap.org/data/2.5/weather?lat=${coords.lat}&lon=${coords.lon}&units=metric&appid=${apiKey}`
  );

  if (!response.ok) {
    throw new Error('Could not retrieve weather data');
  }

  weatherData = await response.json();
} catch {
  error = 'Weather currently unavailable';
  }
*/
---

<div class="weather-card">
  <h3>Live Weather in {location}</h3>

  {error && <p class="error">{error}</p>}

  {weatherData && (
    <div class="weather-info">
      <img 
        src={`https://openweathermap.org/img/wn/${weatherData.weather[0].icon}@2x.png`} 
        alt={weatherData.weather[0].description} 
      />
      <div>
        <p class="temp">{Math.round(weatherData.main.temp)}°C</p>
        <p class="condition">{weatherData.weather[0].description}</p>
        <p class="humidity">Humidity: {weatherData.main.humidity}%</p>
      </div>
    </div>
  )}
</div>
<style>
  .weather-card {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 0.6rem 0.8rem;
    background-color: #fcfcfc;
    max-width: 220px; /* Much narrower */
    margin: 0.5rem 0;
    font-size: 0.85rem; /* Smaller overall text */
  }
  .weather-card h4 {
    margin: 0 0 0.4rem 0;
    font-size: 0.9rem;
    color: #333;
  }
  .weather-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .weather-info img {
    width: 40px;  /* Force image to be small */
    height: 40px;
    margin: -8px; /* Pulls it closer */
  }
  .temp {
    font-size: 1.2rem; /* Reduced from 1.8rem */
    font-weight: bold;
    margin: 0;
    line-height: 1.1;
  }
  .condition {
    text-transform: capitalize;
    margin: 0;
    color: #666;
    font-size: 0.75rem;
  }
  .humidity {
    margin: 0;
    color: #888;
    font-size: 0.7rem;
  }
  .error {
    color: #d9534f;
    font-size: 0.8rem;
  }
</style>
