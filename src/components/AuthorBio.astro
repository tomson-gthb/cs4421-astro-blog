---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'authors'>['data'];

const { name, bio, avatar, social } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-heading">
	<Image class="author-avatar" src={avatar} alt={`Portrait of ${name}`} width={96} height={96} />
	<div>
		<p class="author-label" id="author-heading">About the author</p>
		<h2>{name}</h2>
		<p>{bio}</p>
		{social.length > 0 && (
			<nav aria-label={`${name}'s social links`}>
				<ul>
					{social.map((link) => (
						<li><a href={link.url} rel="me">{link.label}</a></li>
					))}
				</ul>
			</nav>
		)}
	</div>
</section>

<style>
	.author-bio {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.author-avatar {
		flex: 0 0 96px;
		border-radius: 50%;
		object-fit: cover;
	}
	.author-label {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0;
		font-size: 1.5em;
	}
	.author-bio p:not(.author-label) {
		margin: 0.5rem 0;
	}
	ul {
		display: flex;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
		font-size: 0.9em;
	}
	@media (max-width: 520px) {
		.author-bio {
			gap: 1rem;
		}
		.author-avatar {
			flex-basis: 72px;
			width: 72px;
			height: 72px;
		}
	}
</style>